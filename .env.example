# Key OpenAI dùng cho bước dịch. Để trống thì app dùng Google Dịch miễn phí.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model Whisper (MLX). large-v3-turbo: nhanh, tốt cho tiếng Trung.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Cho phép điện thoại trong cùng Wi-Fi mở app (0 = chỉ máy này).
ALLOW_LAN=0
PORT=8000

# Douyin hay cần cookie: điền chrome / safari / firefox để yt-dlp lấy cookie từ trình duyệt.
YTDLP_COOKIES_BROWSER=
# Hoặc (chắc ăn hơn trên macOS mới): file cookies.txt xuất từ douyin.com bằng extension "Get cookies.txt LOCALLY".
# Đường dẫn tương đối tính từ thư mục dự án. File này đã được .gitignore.
YTDLP_COOKIES_FILE=

MAX_UPLOAD_MB=500
MAX_DURATION_MIN=15
